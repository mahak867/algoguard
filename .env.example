# Copy to .env and fill in. Never commit .env.
ALGOGUARD_SECRET_KEY=change-me-to-a-long-random-string
ALGOGUARD_ADMIN_TOKEN=change-me-too
ALGOGUARD_DRY_RUN=true

# Delta Exchange India. Testnet first; production is https://api.india.delta.exchange
ALGOGUARD_DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
ALGOGUARD_DELTA_API_KEY=
ALGOGUARD_DELTA_API_SECRET=

# Optional: HOLD and BLOCK messages on Telegram
ALGOGUARD_TELEGRAM_BOT_TOKEN=
ALGOGUARD_TELEGRAM_CHAT_ID=

# Optional: friendlier explanations (checked against the facts; falls back to the template)
ALGOGUARD_ANTHROPIC_API_KEY=
